# Real email delivery (Resend). Leave unset to use the on-screen demo code.
# 1. Sign up at https://resend.com and create an API key (starts with re_).
# 2. For testing: EMAIL_FROM=onboarding@resend.dev (delivers to your own email only).
#    For customers: verify your domain in Resend (Domains > Add), then use it here.
# 3. Put them here locally (copy this file to .env.local), and in Vercel:
#    Project > Settings > Environment Variables, then redeploy.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=hello@kamgeorge.com
