# Real email delivery (Gmail). Leave unset to use the on-screen demo code.
# 1. Create/use a Gmail for the store, turn on 2-Step Verification.
# 2. Create an App password (Google Account > Security > App passwords).
# 3. Put it here locally (copy this file to .env.local), and in Vercel:
#    Project > Settings > Environment Variables, then redeploy.
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
